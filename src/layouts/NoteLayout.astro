---
import BaseLayout from './BaseLayout.astro';
import FluentIcon from '../components/FluentIcon.astro';
import OnThisPage from '../components/OnThisPage.astro';
import Pager from '../components/Pager.astro';
import Sidebar from '../components/Sidebar.astro';
import { SITE, pageBySlug } from '../data/site';
import { absolute, href } from '../lib/urls';

interface Props {
  slug: string;
  /** Browser/tab title. Defaults to "<label> — DP-800 Study Notes". */
  title?: string;
  description: string;
  /** Page heading. Defaults to the label in the page registry. */
  heading?: string;
  /** Lead paragraph under the heading. */
  intro: string;
  themeColor?: string;
}

const { slug, title, description, heading, intro, themeColor } = Astro.props;

const page = pageBySlug(slug);
if (!page) throw new Error(`NoteLayout: "${slug}" is not registered in src/data/site.ts`);

const docTitle = title ?? `${page.label} — ${SITE.name}`;

const schema = [
  {
    '@type': 'TechArticle',
    '@id': `${absolute(SITE.origin, slug)}#article`,
    headline: heading ?? page.label,
    description,
    url: absolute(SITE.origin, slug),
    inLanguage: 'en',
    isPartOf: { '@id': `${absolute(SITE.origin, '')}#website` },
    author: { '@id': `${SITE.origin}/#person` },
    about: `Exam ${SITE.exam}: ${SITE.examTitle}`,
  },
];
---

<BaseLayout
  title={docTitle}
  description={description}
  slug={slug}
  themeColor={themeColor}
  ogType="article"
  schema={schema}
>
  <div class="layout" data-sidebar="expanded" data-drawer="closed">
    <Sidebar current={slug} />

    {/* .page is an inner grid so the outline can sit beside the prose on wide
        screens and drop between the page head and the body on narrow ones,
        without the element existing twice in the DOM. */}
    <main class="page" id="main" style={`--accent:${page.accent}`}>
      <header class="page-head">
        {/* "Home › Page", as on Microsoft Learn. */}
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href={href('')}>Home</a>
          <span class="sep" aria-hidden="true">›</span>
          <span aria-current="page">{page.navLabel}</span>
        </nav>
        {/* DP-700 v2's page head: a 5px rule in the page accent, an uppercase
            kicker, the H1 and a lead paragraph in soft text. */}
        <div class="ph-block">
          <span class="kicker"><FluentIcon name={page.icon} size={16} />{page.badge}</span>
          <h1>{heading ?? page.label}</h1>
          <p class="lead">{intro}</p>
        </div>
        <div class="page-labels">
          {/* Stated on every page so a reader can tell at a glance whether the
              notes have gone stale against the official study guide. */}
          <span class="pill p-gray">
            <FluentIcon name="calendar_ltr" size={16} />
            Skills measured as of {SITE.skillsMeasured}
          </span>
        </div>
      </header>

      <OnThisPage />

      <div class="content">
        <slot />
      </div>

      <Pager current={slug} />
    </main>
  </div>
</BaseLayout>
